QMainWindow, QDialog {
    background-color: #f4f6f8;
}

QLabel {
    color: #263238;
    font-size: 14px;
}

QPushButton {
    background-color: #2563a6;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 8px 14px;
}

QPushButton:hover {
    background-color: #1d4f87;
}

QTableWidget {
    background-color: white;
    gridline-color: #d7dce1;
}

QHeaderView::section {
    background-color: #e6ebf0;
    color: #263238;
    padding: 6px;
    border: 1px solid #d7dce1;
}

QSpinBox {
    background-color: white;
    padding: 5px;
}
